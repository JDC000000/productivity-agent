# ============================================================
# Productivity Agent — environment config
# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored, so your secrets stay local.
# ============================================================

# --- Phase 1 (required) ---

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Your personal Telegram chat_id. After first /chatid command, paste here.
TELEGRAM_ALLOWED_CHAT_ID=

# --- Phase 2 (required for /brief) ---

# Path to OAuth client credentials downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_PATH=~/.productivity-agent/secrets/credentials.json

# Where the user-consent token gets stored after first OAuth setup.
GOOGLE_TOKEN_PATH=~/.productivity-agent/secrets/token.json

# Google Doc ID for the Task Brain Dump.
# In the doc URL https://docs.google.com/document/d/THIS_PART_HERE/edit, copy THIS_PART_HERE.
BRAIN_DUMP_DOC_ID=

# IANA timezone for "today" calculations. Pacific BC default.
TIMEZONE=America/Vancouver

# --- Phase 3 (not needed yet) ---

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Runtime ---

LOG_LEVEL=INFO
LOG_PATH=~/.productivity-agent/logs/agent.log
